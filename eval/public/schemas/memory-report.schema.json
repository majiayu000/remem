{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majiayu000.github.io/remem/schemas/memory-report.schema.json",
  "title": "remem public memory benchmark report",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "benchmark_version", "suite", "layer", "conditions", "schema_refs", "run_artifacts", "aggregate_metrics", "claim_level", "verifier"],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "benchmark_version": { "type": "string", "minLength": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "layer": { "const": "memory_system_capability" },
    "conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "schema_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "run_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "aggregate_metrics": {
      "type": "object",
      "properties": {
        "suite_content_identity": { "type": "string", "pattern": "^sha256-raw-suite-v1:[0-9a-f]{64}$" }
      }
    },
    "claim_level": { "type": "string", "minLength": 1 },
    "verifier": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "benchmark_id": { "const": "adversarial-policy" },
          "benchmark_version": { "const": "v2" }
        },
        "required": ["benchmark_id", "benchmark_version"]
      },
      "then": {
        "properties": {
          "aggregate_metrics": {
            "required": ["suite", "suite_version", "fixture_revision", "suite_content_identity", "run_count", "policy", "verification_paths", "measurement_sources"],
            "properties": {
              "suite": { "type": "string", "minLength": 1 },
              "suite_version": { "type": "string", "minLength": 1 },
              "fixture_revision": { "type": "string", "minLength": 1 },
              "suite_content_identity": { "type": "string", "pattern": "^sha256-raw-suite-v1:[0-9a-f]{64}$" },
              "run_count": { "type": "integer", "minimum": 1 },
              "policy": { "type": "object" },
              "verification_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "measurement_sources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
